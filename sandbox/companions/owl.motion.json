  "flight": {
    "comment": "arcs: cubic Bezier lifted above the chord. apexLift = fraction of chord length; apexSkew = where along the chord the apex sits; bank deg per (px/ms) of horizontal velocity",
    "apexLift": [
      0.28,
      0.42
    ],
    "apexSkew": [
      0.35,
      0.65
    ],
    "bankPerVx": 55,
