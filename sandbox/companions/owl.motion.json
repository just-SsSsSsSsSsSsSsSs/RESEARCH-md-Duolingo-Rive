{
  "id": "owl",
  "name": "حكيمة",
  "art": "companions/owl_p2.svg",
  "flyer": true,
  "hierarchy": {
    "comment": "overlapping action: each joint follows its parent's motion with a delay (ms) and a gain",
    "body": {
      "parent": "root",
      "delayMs": 40,
      "gain": 0.9
    },
    "head": {
      "parent": "body",
      "delayMs": 110,
      "gain": 0.75
    },
    "removedEyes": "hierarchy.eyes (delayMs 60) was never read by code (grep 0 uses, 2026-09-26); eye timing is governed by acting.lead/leadMs (eyes first). Removed to end the silent two-system conflict."
  },
  "secondary": {
    "comment": "spring-damper groups driven by the character's own velocity/acceleration. k stiffness (1/s^2), c damping (1/s), gainV deg per (px/ms), gainA deg per (px/ms^2), axis of the driving component, limit deg, settleMs how long the solver keeps running after the primary motion stops",
    "armL": {
      "k": 180,
      "c": 16,
      "gainV": -38,
      "gainA": -220,
      "axis": "y",
      "limit": 55,
      "settleMs": 900
    },
    "armR": {
      "k": 180,
      "c": 16,
      "gainV": 38,
      "gainA": 220,
      "axis": "y",
      "limit": 55,
      "settleMs": 900
    },
    "head": {
      "k": 260,
      "c": 20,
      "gainV": -6,
      "gainA": -60,
      "axis": "x",
      "limit": 14,
      "settleMs": 700
    },
    "legL": {
      "k": 120,
      "c": 10,
      "gainV": -22,
      "gainA": -90,
      "axis": "x",
      "limit": 40,
      "settleMs": 1100
    },
    "legR": {
      "k": 120,
      "c": 10,
      "gainV": -22,
      "gainA": -90,
      "axis": "x",
      "limit": 40,
      "settleMs": 1100
    }
  },
  "squash": {
    "comment": "volume preserving: scaleX = 1 / scaleY. Landing is a spring towards 1 from the impact value",
